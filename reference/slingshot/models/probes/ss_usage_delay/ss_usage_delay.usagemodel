<?xml version="1.0" encoding="UTF-8"?>
<usagemodel:UsageModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:usagemodel="http://palladiosimulator.org/PalladioComponentModel/UsageModel/5.2" xmlns:stoex="http://sdq.ipd.uka.de/StochasticExpressions/2.2">
  <usageScenario_UsageModel id="_ss_usage_delay_us1" entityName="Scenario">
    <scenarioBehaviour_UsageScenario id="_ss_usage_delay_us1_sb" entityName="behaviour">
      <actions_ScenarioBehaviour xsi:type="usagemodel:Start" id="_ss_usage_delay_ua1" entityName="start" successor="_ss_usage_delay_ua2"/>
      <actions_ScenarioBehaviour xsi:type="usagemodel:Delay" id="_ss_usage_delay_ua2" entityName="nap" successor="_ss_usage_delay_ua3" predecessor="_ss_usage_delay_ua1">
        <timeSpecification_Delay specification="Exp(4.0)"/>
      </actions_ScenarioBehaviour>
      <actions_ScenarioBehaviour xsi:type="usagemodel:EntryLevelSystemCall" id="_ss_usage_delay_ua3" entityName="callOp" successor="_ss_usage_delay_ua4" predecessor="_ss_usage_delay_ua2">
        <providedRole_EntryLevelSystemCall href="ss_usage_delay.system#_ss_usage_delay_sysprov1"/>
        <operationSignature__EntryLevelSystemCall href="ss_usage_delay.repository#_ss_usage_delay_op"/>
      </actions_ScenarioBehaviour>
      <actions_ScenarioBehaviour xsi:type="usagemodel:Stop" id="_ss_usage_delay_ua4" entityName="stop" predecessor="_ss_usage_delay_ua3"/>
    </scenarioBehaviour_UsageScenario>
    <workload_UsageScenario xsi:type="usagemodel:ClosedWorkload" population="1">
      <thinkTime_ClosedWorkload specification="0.25"/>
    </workload_UsageScenario>
  </usageScenario_UsageModel>
</usagemodel:UsageModel>
