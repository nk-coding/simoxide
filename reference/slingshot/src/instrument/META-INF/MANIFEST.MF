Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: SimOxide Slingshot instrumentation (trace, tape, SPD log)
Bundle-SymbolicName: simoxide.slingshot.instrument;singleton:=true
Bundle-Version: 1.0.0
Bundle-RequiredExecutionEnvironment: JavaSE-21
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.emf.ecore,
 org.apache.log4j,
 com.google.inject,
 org.palladiosimulator.analyzer.slingshot.core,
 org.palladiosimulator.analyzer.slingshot.common,
 org.palladiosimulator.analyzer.slingshot.common.utils,
 org.palladiosimulator.analyzer.slingshot.eventdriver,
 org.palladiosimulator.analyzer.slingshot.behavior.usagesimulation.data,
 org.palladiosimulator.analyzer.slingshot.behavior.systemsimulation.data,
 org.palladiosimulator.analyzer.slingshot.behavior.resourcesimulation.data,
 org.palladiosimulator.analyzer.slingshot.behavior.spd.data,
 org.palladiosimulator.analyzer.slingshot.monitor.data,
 org.palladiosimulator.pcm,
 org.palladiosimulator.spd,
 org.palladiosimulator.spd.semantic,
 org.palladiosimulator.edp2,
 org.palladiosimulator.metricspec,
 org.palladiosimulator.measurementframework,
 org.jscience
DynamicImport-Package: *
Export-Package: simoxide.slingshot.instrument
