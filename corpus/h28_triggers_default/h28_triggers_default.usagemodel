<?xml version="1.0" encoding="UTF-8"?>
<usagemodel:UsageModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:usagemodel="http://palladiosimulator.org/PalladioComponentModel/UsageModel/5.2">
  <usageScenario_UsageModel id="_h28_triggers_default_us1" entityName="Scenario">
    <scenarioBehaviour_UsageScenario id="_h28_triggers_default_sb1" entityName="behaviour">
      <actions_ScenarioBehaviour xsi:type="usagemodel:Start" id="_h28_triggers_default_ua3" entityName="start" successor="_h28_triggers_default_ua1"/>
      <actions_ScenarioBehaviour xsi:type="usagemodel:Delay" id="_h28_triggers_default_ua1" entityName="warmup" successor="_h28_triggers_default_ua2"
          predecessor="_h28_triggers_default_ua3">
        <timeSpecification_Delay specification="0.25"/>
      </actions_ScenarioBehaviour>
      <actions_ScenarioBehaviour xsi:type="usagemodel:EntryLevelSystemCall" id="_h28_triggers_default_ua2" entityName="callOp"
          successor="_h28_triggers_default_ua4" predecessor="_h28_triggers_default_ua1">
        <providedRole_EntryLevelSystemCall href="h28_triggers_default.system#_h28_triggers_default_prov2"/>
        <operationSignature__EntryLevelSystemCall href="h28_triggers_default.repository#_h28_triggers_default_sig1"/>
      </actions_ScenarioBehaviour>
      <actions_ScenarioBehaviour xsi:type="usagemodel:Stop" id="_h28_triggers_default_ua4" entityName="stop" predecessor="_h28_triggers_default_ua2"/>
    </scenarioBehaviour_UsageScenario>
    <workload_UsageScenario xsi:type="usagemodel:ClosedWorkload" population="3">
      <thinkTime_ClosedWorkload specification="Exp(2.0)"/>
    </workload_UsageScenario>
  </usageScenario_UsageModel>
</usagemodel:UsageModel>
