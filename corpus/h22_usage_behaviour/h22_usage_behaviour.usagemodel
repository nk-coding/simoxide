    xmlns:usagemodel="http://palladiosimulator.org/PalladioComponentModel/UsageModel/5.2">
  <usageScenario_UsageModel id="_h22_usage_behaviour_us1" entityName="Scenario">
    <scenarioBehaviour_UsageScenario id="_h22_usage_behaviour_sb4" entityName="behaviour">
      <actions_ScenarioBehaviour xsi:type="usagemodel:Start" id="_h22_usage_behaviour_ua12" entityName="start" successor="_h22_usage_behaviour_ua1"/>
      <actions_ScenarioBehaviour xsi:type="usagemodel:Delay" id="_h22_usage_behaviour_ua1" entityName="think" successor="_h22_usage_behaviour_ua11"
          predecessor="_h22_usage_behaviour_ua12">
        <timeSpecification_Delay specification="Exp(2.0)"/>
      </actions_ScenarioBehaviour>
      <actions_ScenarioBehaviour xsi:type="usagemodel:Branch" id="_h22_usage_behaviour_ua11" entityName="choice" successor="_h22_usage_behaviour_ua13"
          predecessor="_h22_usage_behaviour_ua1">
        <branchTransitions_Branch branchProbability="0.3">
          <branchedBehaviour_BranchTransition id="_h22_usage_behaviour_sb1" entityName="behaviour">
            <actions_ScenarioBehaviour xsi:type="usagemodel:Start" id="_h22_usage_behaviour_ua3" entityName="start" successor="_h22_usage_behaviour_ua2"/>
            <actions_ScenarioBehaviour xsi:type="usagemodel:EntryLevelSystemCall" id="_h22_usage_behaviour_ua2" entityName="doRead"
                successor="_h22_usage_behaviour_ua4" predecessor="_h22_usage_behaviour_ua3">
              <providedRole_EntryLevelSystemCall href="h22_usage_behaviour.system#_h22_usage_behaviour_prov2"/>
              <operationSignature__EntryLevelSystemCall href="h22_usage_behaviour.repository#_h22_usage_behaviour_sig1"/>
            </actions_ScenarioBehaviour>
            <actions_ScenarioBehaviour xsi:type="usagemodel:Stop" id="_h22_usage_behaviour_ua4" entityName="stop" predecessor="_h22_usage_behaviour_ua2"/>
          </branchedBehaviour_BranchTransition>
        </branchTransitions_Branch>
        <branchTransitions_Branch branchProbability="0.7">
          <branchedBehaviour_BranchTransition id="_h22_usage_behaviour_sb3" entityName="behaviour">
            <actions_ScenarioBehaviour xsi:type="usagemodel:Start" id="_h22_usage_behaviour_ua9" entityName="start" successor="_h22_usage_behaviour_ua6"/>
            <actions_ScenarioBehaviour xsi:type="usagemodel:Loop" id="_h22_usage_behaviour_ua6" entityName="writes" successor="_h22_usage_behaviour_ua10"
                predecessor="_h22_usage_behaviour_ua9">
              <loopIteration_Loop specification="IntPMF[(1;0.5)(2;0.5)]"/>
              <bodyBehaviour_Loop id="_h22_usage_behaviour_sb2" entityName="behaviour">
                <actions_ScenarioBehaviour xsi:type="usagemodel:Start" id="_h22_usage_behaviour_ua7" entityName="start" successor="_h22_usage_behaviour_ua5"/>
                <actions_ScenarioBehaviour xsi:type="usagemodel:EntryLevelSystemCall" id="_h22_usage_behaviour_ua5" entityName="doWrite"
                    successor="_h22_usage_behaviour_ua8" predecessor="_h22_usage_behaviour_ua7">
                  <providedRole_EntryLevelSystemCall href="h22_usage_behaviour.system#_h22_usage_behaviour_prov2"/>
                  <operationSignature__EntryLevelSystemCall href="h22_usage_behaviour.repository#_h22_usage_behaviour_sig2"/>
                </actions_ScenarioBehaviour>
                <actions_ScenarioBehaviour xsi:type="usagemodel:Stop" id="_h22_usage_behaviour_ua8" entityName="stop" predecessor="_h22_usage_behaviour_ua5"/>
              </bodyBehaviour_Loop>
            </actions_ScenarioBehaviour>
            <actions_ScenarioBehaviour xsi:type="usagemodel:Stop" id="_h22_usage_behaviour_ua10" entityName="stop" predecessor="_h22_usage_behaviour_ua6"/>
          </branchedBehaviour_BranchTransition>
        </branchTransitions_Branch>
      </actions_ScenarioBehaviour>
      <actions_ScenarioBehaviour xsi:type="usagemodel:Stop" id="_h22_usage_behaviour_ua13" entityName="stop" predecessor="_h22_usage_behaviour_ua11"/>
    </scenarioBehaviour_UsageScenario>
    <workload_UsageScenario xsi:type="usagemodel:ClosedWorkload" population="3">
      <thinkTime_ClosedWorkload specification="Exp(1.0)"/>
    </workload_UsageScenario>
  </usageScenario_UsageModel>
