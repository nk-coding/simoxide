# Rust
/target/
**/*.rs.bk

# Java build outputs (regenerated by reference/build.sh, the oracles' build.sh and bench/compare/build.sh)
/reference/build/
/reference/oracles/*/build/
/bench/compare/build/
/bench/compare/simucom/work/
*.class

# Benchmark raw data and run logs. The summaries (results/*.csv, results/tables*.md) and
# docs/performance/comparison.md are kept; bench/compare/run-all.sh regenerates the rest.
/bench/compare/results/raw/
/bench/compare/results/tmp/
/bench/compare/results/*.log
/bench/compare/results/raw.csv
/bench/compare/results/sus_runs.csv
/bench/compare/results/raw-archive/

# Profiling output
*.folded
perf.data*
flamegraph*.svg

# Python, editors, OS
__pycache__/
*.pyc
.venv/
.idea/
.vscode/
*.swp
*~
.DS_Store
*.tmp

# Agent worktrees
/.claude/

# Documentation site (VitePress)
/docs/node_modules/
/docs/.vitepress/cache/
/docs/.vitepress/dist/
