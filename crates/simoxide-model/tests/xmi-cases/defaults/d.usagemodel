<?xml version="1.0" encoding="UTF-8"?>
<usagemodel:UsageModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:usagemodel="http://palladiosimulator.org/PalladioComponentModel/UsageModel/5.2" xmlns:stoex="http://sdq.ipd.uka.de/StochasticExpressions/2.2">
  <usageScenario_UsageModel id="_us">
    <scenarioBehaviour_UsageScenario id="_sb">
      <actions_ScenarioBehaviour xsi:type="usagemodel:Start" id="_st" successor="_br"/>
      <actions_ScenarioBehaviour xsi:type="usagemodel:Branch" id="_br" predecessor="_st" successor="_sp">
        <branchTransitions_Branch branchProbability="0.25">
          <branchedBehaviour_BranchTransition id="_bb1">
            <actions_ScenarioBehaviour xsi:type="usagemodel:Start" id="_x1" successor="_x2"/>
            <actions_ScenarioBehaviour xsi:type="usagemodel:Stop" id="_x2" predecessor="_x1"/>
          </branchedBehaviour_BranchTransition>
        </branchTransitions_Branch>
        <branchTransitions_Branch>
          <branchedBehaviour_BranchTransition id="_bb2"/>
        </branchTransitions_Branch>
      </actions_ScenarioBehaviour>
      <actions_ScenarioBehaviour xsi:type="usagemodel:Stop" id="_sp" predecessor="_br"/>
    </scenarioBehaviour_UsageScenario>
    <workload_UsageScenario xsi:type="usagemodel:ClosedWorkload">
      <thinkTime_ClosedWorkload specification="Exp(0.5)"/>
    </workload_UsageScenario>
  </usageScenario_UsageModel>
  <userData_UsageModel>
    <userDataParameterUsages_UserData>
      <variableCharacterisation_VariableUsage>
        <specification_VariableCharacterisation specification="3"/>
      </variableCharacterisation_VariableUsage>
      <namedReference__VariableUsage xsi:type="stoex:NamespaceReference" referenceName="a">
        <innerReference_NamespaceReference xsi:type="stoex:VariableReference" referenceName="b"/>
      </namedReference__VariableUsage>
    </userDataParameterUsages_UserData>
  </userData_UsageModel>
</usagemodel:UsageModel>
