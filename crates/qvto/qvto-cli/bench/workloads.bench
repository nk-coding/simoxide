in target/qvto-bench/gen/pcm/spd-x10/default.spd
in target/qvto-bench/gen/pcm/spd-x10/default.semanticspd
in target/qvto-bench/gen/pcm/spd-x10/default.usagemodel
conf target/pcm/pcm.conf
imports root crates/qvto-testkit/corpus/spd/transformations
