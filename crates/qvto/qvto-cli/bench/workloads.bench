# B3: Slingshot's SPD MainTransformation (minimal example; scaled resource environments)

case b3_spd_main_x1
kind bench
qvto crates/qvto-testkit/corpus/spd/transformations/spd/MainTransformation.qvto
in target/qvto-bench/gen/pcm/spd-x1/default.allocation
in target/qvto-bench/gen/pcm/spd-x1/default.system
in target/qvto-bench/gen/pcm/spd-x1/My.resourceenvironment
in target/qvto-bench/gen/pcm/spd-x1/default.repository
in target/qvto-bench/gen/pcm/spd-x1/default.spd
in target/qvto-bench/gen/pcm/spd-x1/default.semanticspd
in target/qvto-bench/gen/pcm/spd-x1/default.usagemodel
conf target/pcm/pcm.conf
imports root crates/qvto-testkit/corpus/spd/transformations
config keepModeling=true
bench group B3
end

case b3_spd_main_x10
kind bench
qvto crates/qvto-testkit/corpus/spd/transformations/spd/MainTransformation.qvto
