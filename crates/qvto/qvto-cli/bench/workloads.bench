# B2 series: a rule run 50 times on the same model, as SimuLizar runs it at every trigger during a simulation

case b2_lb_scaleUp_series_x1
kind bench
qvto target/qvto-bench/gen/pcm/loadbalancer-x1/scaleUp.qvto
in target/qvto-bench/gen/pcm/loadbalancer-x1/prm-high.xmi
in target/qvto-bench/gen/pcm/loadbalancer-x1/loadbalancer_on_iaas.allocation
conf target/pcm/pcm.conf
imports folder
bench group B2
bench series 50
end

case b2_lb_scaleIn_series_x1
kind bench
qvto target/qvto-bench/gen/pcm/loadbalancer-x1/scaleIn.qvto
in target/qvto-bench/gen/pcm/loadbalancer-x1/prm-high.xmi
in target/qvto-bench/gen/pcm/loadbalancer-x1/loadbalancer_on_iaas.allocation
conf target/pcm/pcm.conf
imports folder
