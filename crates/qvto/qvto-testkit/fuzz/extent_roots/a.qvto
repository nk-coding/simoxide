modeltype FZ uses fz('http://qvto-rs/fuzz');
transformation a(in m : FZ, out o : FZ);
main() {
	var r := object FZ::Root { name := 'r'; };
	r.nodes += object FZ::Node { name := 'x'; };
	r.nodes += object FZ::Node { name := 'y'; };
	log('q', FZ::Node.allInstances()->size());
	r.nodes := r.nodes->excluding(r.nodes->first());
	log('roots', o.rootObjects()->size());
}
