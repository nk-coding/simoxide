# SimuLizar reconfiguration rules and SPD semantic transformations on PCM models (hand-written).
# Material: qvto-testkit/corpus (tools/copy-corpus.sh). Metamodels: target/pcm/pcm.conf from
# ../foundation/simoxide-emf/tools/pcm-setup.sh target/pcm (PCM 5.2.2 .ecore files, SimuLizar and SPD metamodels), as
# dynamic EMF on both sides. Format: qvto-testkit/README.md. The Java runner is the oracle here:
# besides the severity checks, the cases are compared with the recorded Java results.

case simulizar_runconfigtest_scaleUp_high
driver simulizar.QVToReconfigurationTest
kind simulizar-rule
dir qvto-testkit/corpus/simulizar/runconfigtest
qvto scaleUp.qvto
in prm-high.xmi
in server.allocation
conf target/pcm/pcm.conf
imports folder
source Palladio-Analyzer-SimuLizar/tests/org.palladiosimulator.simulizar.tests/testmodels/runconfigtest/rules
dump models
check severity 0 0
end

