<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="contract" nsURI="http://qvto-rs/contract" nsPrefix="contract">
  <eClassifiers xsi:type="ecore:EDataType" name="String" instanceClassName="java.lang.String"/>
  <eClassifiers xsi:type="ecore:EDataType" name="Int" instanceClassName="int"/>
  <eClassifiers xsi:type="ecore:EDataType" name="Integer" instanceClassName="java.lang.Integer"/>
  <eClassifiers xsi:type="ecore:EDataType" name="Long" instanceClassName="long"/>
  <eClassifiers xsi:type="ecore:EDataType" name="Double" instanceClassName="double"/>
  <eClassifiers xsi:type="ecore:EDataType" name="Boolean" instanceClassName="boolean"/>
  <eClassifiers xsi:type="ecore:EEnum" name="Kind">
    <eLiterals name="A"/>
    <eLiterals name="B" value="1"/>
    <eLiterals name="C" value="2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Base" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="#//String"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="#//String" iD="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Node" eSuperTypes="#//Base">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="count" eType="#//Int"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label" eType="#//String"
        defaultValueLiteral="x"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="opt" eType="#//String" unsettable="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" eType="#//Kind"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="big" eType="#//Long"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ratio" eType="#//Double"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="flag" eType="#//Boolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="boxed" eType="#//Integer"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tags" upperBound="-1" eType="#//String"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nums" unique="false" upperBound="-1"
        eType="#//Int"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="children" upperBound="-1"
        eType="#//Node" containment="true" resolveProxies="false" eOpposite="#//Node/parent"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent" eType="#//Node" transient="true"
        resolveProxies="false" eOpposite="#//Node/children"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="child" eType="#//Node" containment="true"
        resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="xchildren" upperBound="-1"
        eType="#//Node" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="links" upperBound="-1" eType="#//Node"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="bag" unique="false" upperBound="-1"
        eType="#//Node"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="friend" eType="#//Node" eOpposite="#//Node/friend"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner" eType="#//Node" eOpposite="#//Node/owned"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owned" upperBound="-1" eType="#//Node"
        eOpposite="#//Node/owner"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="targets" upperBound="-1"
        eType="#//Node" eOpposite="#//Node/sources"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sources" upperBound="-1"
        eType="#//Node" eOpposite="#//Node/targets"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="only" eType="#//Sub"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Sub" eSuperTypes="#//Node">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="extra" eType="#//String"/>
  </eClassifiers>
</ecore:EPackage>
