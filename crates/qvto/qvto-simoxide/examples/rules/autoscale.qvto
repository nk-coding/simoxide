/*
 * A SimuLizar-style reconfiguration rule for the runtime-flow example: scales out by cloning a
 * resource container when the measured utilisation is above the upper threshold (after a
 * warm-up time), and scales in by removing the newest clone below the lower threshold.
 */
import org.palladiosimulator.simulizar.action.repository.black.SimulationStateLibrary;

modeltype RUNTIMEMEASUREMENT uses 'http://simulizar.palladiosimulator.org/RuntimeMeasurement/1.0';
modeltype PCM_ALLOC uses 'http://palladiosimulator.org/PalladioComponentModel/Allocation/5.2';
modeltype PCM_RES_ENV uses 'http://palladiosimulator.org/PalladioComponentModel/ResourceEnvironment/5.2';

transformation Autoscale(in prm : RUNTIMEMEASUREMENT,
                         in pcmAllocation : PCM_ALLOC,
                         inout pcmResources : PCM_RES_ENV) {

	property upper : Real = 0.8;
	property lower : Real = 0.3;
	property warmUp : Real = 10.0;

	main() {
		var u : Real := prm.rootObjects()[RuntimeMeasurement]->any(true).measuringValue;
		var now : Real := getSimulationTime();
		var env := pcmResources.rootObjects()[ResourceEnvironment]->any(true);
		var clones := env.resourceContainer_ResourceEnvironment
			->select(c | c.entityName.startsWith('clone'))
			->sortedBy(c | c.entityName);
		if (u > upper and now >= warmUp) then {
			var template := env.resourceContainer_ResourceEnvironment
				->select(c | not c.entityName.startsWith('clone'))
				->sortedBy(c | c.entityName)->first();
			var c := template.deepclone().oclAsType(ResourceContainer);
			c.entityName := 'clone ' + (clones->size() + 1).toString() + ' of ' + template.entityName;
			c.id := template.id + '_clone' + (clones->size() + 1).toString();
			env.resourceContainer_ResourceEnvironment += c;
			log('t=' + now.toString() + ' u=' + u.toString() + ': scale out to ' + (clones->size() + 1).toString() + ' clone(s)');
		} elif (u < lower and clones->notEmpty()) then {
			var last := clones->last();
			env.resourceContainer_ResourceEnvironment := env.resourceContainer_ResourceEnvironment->excluding(last);
			log('t=' + now.toString() + ' u=' + u.toString() + ': scale in, removed ' + last.entityName);
		} else {
			log('t=' + now.toString() + ' u=' + u.toString() + ': no change');
		} endif;
	}
}
